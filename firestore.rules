rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == "comercial@pedeai.com.br" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
      );
    }

    // Acesso irrestrito total para SuperAdmin em qualquer documento
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Lojas (Stores)
    match /stores/{storeId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if true;

      // Subcoleção de Produtos da Loja (se houver)
      match /products/{productId} {
        allow read, write: if true;
      }

      // Subcoleção de Pagamentos da Loja
      match /pagamentos/{pagamentoId} {
        allow read, write: if true;
      }
    }

    // Solicitações de Confirmação de Pagamento (Lojista -> SuperAdmin)
    match /saas_payment_requests/{reqId} {
      allow read, write: if true;
    }

    // Pagamentos Globais do SaaS
    match /saas_payments/{paymentId} {
      allow read, write: if true;
    }

    // Pedidos (Orders)
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Cardápio e Configurações
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    match /option_groups/{groupId} {
      allow read: if true;
      allow write: if true;
    }

    match /delivery_zones/{zoneId} {
      allow read: if true;
      allow write: if true;
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if true;
    }

    match /couriers/{courierId} {
      allow read: if true;
      allow write: if true;
    }

    // Usuários: Impede auto-atribuição do role 'superadmin' por não-superadmins
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() || (
        (!('role' in request.resource.data) || request.resource.data.role != 'superadmin')
      );
      allow delete: if isSuperAdmin();
    }

    // Configuração Global do SaaS / Plataforma
    match /saas_config/{configId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Coleção de teste de conexão
    match /test/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
