rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return request.auth != null && (
        (request.auth.token.email != null && request.auth.token.email == "comercial@pedeai.com.br") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (getUserData().role == 'superadmin' || getUserData().role == 'master'))
      );
    }

    function isStoreOwner(storeId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().storeId == storeId &&
        getUserData().ativo != false;
    }

    // Acesso irrestrito total para SuperAdmin em qualquer documento
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Lojas (Stores)
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSuperAdmin();
      // SuperAdmin ou lojista podem atualizar tudo.
      // Clientes podem atualizar exclusivamente o contador sequencial de pedidos (nextOrderNumber)
      allow update: if isSuperAdmin() || isStoreOwner(storeId) ||
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextOrderNumber']) &&
                     request.resource.data.nextOrderNumber > resource.data.nextOrderNumber);
      allow delete: if isSuperAdmin();

      match /products/{productId} {
        allow read: if true;
        allow write: if isSuperAdmin() || isStoreOwner(storeId);
      }
      match /pagamentos/{pagamentoId} {
        allow read: if isSuperAdmin() || isStoreOwner(storeId);
        allow write: if isSuperAdmin();
      }
    }

    // Pedidos (Orders)
    match /orders/{orderId} {
      // Leitura permitida para SuperAdmin, lojista da loja ou consulta por ID de pedido
      allow read: if isSuperAdmin() || 
                    (resource.data.storeId != null && isStoreOwner(resource.data.storeId)) ||
                    (request.auth != null && resource.data.customerUid == request.auth.uid) ||
                    (resource.data.customerUid != null);
      
      // Criação permitida para SuperAdmin, lojista ou clientes (com status inicial não confirmado)
      allow create: if request.resource.data.storeId != null && (
        isSuperAdmin() ||
        isStoreOwner(request.resource.data.storeId) ||
        (request.resource.data.pagamento.status != 'confirmado' &&
         request.resource.data.customerUid != null &&
         (request.auth == null || request.resource.data.customerUid == request.auth.uid || request.auth.uid != null))
      );

      // Atualização permitida para o lojista da loja ou SuperAdmin.
      // Clientes autenticados podem apenas informar comprovante/anotações no pagamento,
      // sem alterar status geral do pedido, valores financeiros, itens ou confirmar o pagamento por conta própria.
      allow update: if isSuperAdmin() ||
                     (resource.data.storeId != null && isStoreOwner(resource.data.storeId)) ||
                     (request.auth != null && resource.data.customerUid == request.auth.uid &&
                      request.resource.data.pagamento.status != 'confirmado' &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'total', 'subtotal', 'desconto', 'taxaEntrega', 'itens', 'storeId', 'numero', 'customerUid']));

      allow delete: if isSuperAdmin();
    }

    // Categorias do Cardápio
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (request.resource.data.storeId != null && isStoreOwner(request.resource.data.storeId));
      allow update: if isSuperAdmin() || (isStoreOwner(resource.data.storeId) && request.resource.data.storeId == resource.data.storeId);
      allow delete: if isSuperAdmin() || isStoreOwner(resource.data.storeId);
    }

    // Produtos do Cardápio
    match /products/{productId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (request.resource.data.storeId != null && isStoreOwner(request.resource.data.storeId));
      allow update: if isSuperAdmin() || (isStoreOwner(resource.data.storeId) && request.resource.data.storeId == resource.data.storeId);
      allow delete: if isSuperAdmin() || isStoreOwner(resource.data.storeId);
    }

    // Grupos de Opcionais e Complementos
    match /option_groups/{groupId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (request.resource.data.storeId != null && isStoreOwner(request.resource.data.storeId));
      allow update: if isSuperAdmin() || (isStoreOwner(resource.data.storeId) && request.resource.data.storeId == resource.data.storeId);
      allow delete: if isSuperAdmin() || isStoreOwner(resource.data.storeId);
    }

    // Zonas de Entrega / Bairros
    match /delivery_zones/{zoneId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (request.resource.data.storeId != null && isStoreOwner(request.resource.data.storeId));
      allow update: if isSuperAdmin() || (isStoreOwner(resource.data.storeId) && request.resource.data.storeId == resource.data.storeId);
      allow delete: if isSuperAdmin() || isStoreOwner(resource.data.storeId);
    }

    // Cupons de Desconto
    match /coupons/{couponId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (request.resource.data.storeId != null && isStoreOwner(request.resource.data.storeId));
      allow update: if isSuperAdmin() || (isStoreOwner(resource.data.storeId) && request.resource.data.storeId == resource.data.storeId);
      allow delete: if isSuperAdmin() || isStoreOwner(resource.data.storeId);
    }

    // Entregadores (Couriers)
    match /couriers/{courierId} {
      allow read: if isSuperAdmin() || isStoreOwner(resource.data.storeId);
      allow create: if isSuperAdmin() || (request.resource.data.storeId != null && isStoreOwner(request.resource.data.storeId));
      allow update: if isSuperAdmin() || (isStoreOwner(resource.data.storeId) && request.resource.data.storeId == resource.data.storeId);
      allow delete: if isSuperAdmin() || isStoreOwner(resource.data.storeId);
    }

    // Usuários da Plataforma (Perfis)
    match /users/{userId} {
      allow read: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId);
      // Criação: SuperAdmin ou o próprio usuário registrando perfil inicial comum sem privilégios
      allow create: if isSuperAdmin() || (
        request.auth != null && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'customer') &&
        !('storeId' in request.resource.data) &&
        !('ativo' in request.resource.data)
      );
      // Atualização: SuperAdmin pode tudo; usuário comum NÃO pode alterar role, storeId, uid, email ou ativo
      allow update: if isSuperAdmin() || (
        request.auth != null && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'storeId', 'uid', 'email', 'ativo', 'criadoEm'])
      );
      allow delete: if isSuperAdmin();
    }

    // Configuração Global de Taxa Operacional
    match /operational_fee_config/{configId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // Lançamentos Financeiros da Taxa Operacional por Pedido
    match /operational_fee_entries/{entryId} {
      allow read: if isSuperAdmin() || isStoreOwner(resource.data.storeId);
      allow create: if request.auth != null && (isSuperAdmin() || isStoreOwner(request.resource.data.storeId));
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Faturas / Cobranças Operacionais
    match /operational_invoices/{invoiceId} {
      allow read: if isSuperAdmin() || isStoreOwner(resource.data.storeId);
      allow create: if isSuperAdmin();
      // Lojista pode apenas enviar comprovante (status -> aguardando_confirmacao)
      allow update: if isSuperAdmin() || (
        isStoreOwner(resource.data.storeId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'comprovanteTexto', 'comprovanteEnviadoEm']) &&
        request.resource.data.status == 'aguardando_confirmacao'
      );
      allow delete: if isSuperAdmin();
    }

    // Solicitações de Confirmação de Pagamento de Assinatura (SaaS)
    match /saas_payment_requests/{reqId} {
      allow read: if isSuperAdmin() || isStoreOwner(resource.data.storeId);
      allow create: if isSuperAdmin() || isStoreOwner(request.resource.data.storeId);
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Histórico de Pagamentos de Assinatura SaaS
    match /saas_payments/{paymentId} {
      allow read: if isSuperAdmin() || isStoreOwner(resource.data.storeId);
      allow write: if isSuperAdmin();
    }

    // Configuração Global da Plataforma
    match /saas_config/{configId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Telemetria e Métricas de Visitas do Cardápio Digital
    match /storefront_analytics/{logId} {
      allow read: if isSuperAdmin() || (resource.data.storeId != null && isStoreOwner(resource.data.storeId));
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // Auditoria Administrativa do Super Admin (somente leitura para SuperAdmin, append-only)
    match /admin_audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }
  }
}
