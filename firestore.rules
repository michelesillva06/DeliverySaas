rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == "comercial@pedeai.com.br" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
      );
    }

    // Acesso irrestrito total para SuperAdmin
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Lojas (Stores)
    match /stores/{storeId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (isSuperAdmin() || request.auth.token.storeId == storeId);
      allow delete: if isSuperAdmin();

      match /products/{productId} {
        allow read: if true;
        allow write: if request.auth != null && (isSuperAdmin() || request.auth.token.storeId == storeId);
      }
      match /pagamentos/{pagamentoId} {
        allow read: if request.auth != null && (isSuperAdmin() || request.auth.token.storeId == storeId);
        allow write: if request.auth != null && (isSuperAdmin() || request.auth.token.storeId == storeId);
      }
    }

    // Pedidos (Orders) - Apenas lojistas autorizados ou SuperAdmin
    match /orders/{orderId} {
      allow read: if request.auth != null && (isSuperAdmin() || resource.data.storeId == request.auth.token.storeId);
      allow create: if true; // Clientes podem criar pedidos
      allow update: if request.auth != null && (isSuperAdmin() || resource.data.storeId == request.auth.token.storeId);
      allow delete: if isSuperAdmin();
    }

    // Configurações de Loja
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null && (isSuperAdmin() || resource.data.storeId == request.auth.token.storeId);
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && (isSuperAdmin() || resource.data.storeId == request.auth.token.storeId);
    }

    match /option_groups/{groupId} {
      allow read: if true;
      allow write: if request.auth != null && (isSuperAdmin() || resource.data.storeId == request.auth.token.storeId);
    }

    // Módulo de Taxa Operacional
    match /operational_fee_config/{configId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    match /operational_fee_entries/{entryId} {
      allow read: if request.auth != null && (isSuperAdmin() || resource.data.storeId == request.auth.token.storeId);
      allow create: if true;
      allow update: if isSuperAdmin();
    }

    match /operational_invoices/{invoiceId} {
      allow read: if request.auth != null && (isSuperAdmin() || resource.data.storeId == request.auth.token.storeId);
      allow write: if isSuperAdmin();
    }

    // Outros: Usuários, Logs, Config
    match /users/{userId} {
      allow read: if request.auth != null && (isSuperAdmin() || request.auth.uid == userId);
      allow create, update: if isSuperAdmin() || request.auth.uid == userId;
      allow delete: if isSuperAdmin();
    }
  }
}
