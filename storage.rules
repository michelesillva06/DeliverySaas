rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSuperAdmin() {
      return request.auth != null && (
        (request.auth.token.email != null && request.auth.token.email == 'comercial@pedeai.com.br') ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'superadmin' ||
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'master'))
      );
    }

    function isStoreOwner(storeId) {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.storeId == storeId &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.ativo != false;
    }

    match /stores/{storeId}/{allPaths=**} {
      // Leitura pública de fotos de lojas, logos e produtos
      allow read: if true;

      // Upload e atualização: apenas SuperAdmin ou lojista autorizado, limite de 2MB e validação de tipo de imagem
      allow create, update: if (isSuperAdmin() || isStoreOwner(storeId))
                           && request.resource != null
                           && request.resource.size <= 2 * 1024 * 1024
                           && request.resource.contentType.matches('image/(jpeg|png|webp|gif|svg\\+xml)');

      // Exclusão tratada separadamente sem acessar request.resource
      allow delete: if isSuperAdmin() || isStoreOwner(storeId);
    }
  }
}
